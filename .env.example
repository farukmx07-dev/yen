# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=market
MYSQL_PASSWORD=market_secret_change_me
MYSQL_ROOT_PASSWORD=root_secret_change_me
MYSQL_DATABASE=market
MYSQL_POOL_SIZE=20

# Sunucu
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
# Local: PORT doluysa 3001, 3002... dener. Coolify'da PORT_FALLBACK tanimlama.
# PORT_FALLBACK=1

# Coolify / Docker Compose icinde MYSQL_HOST=mysql olur
# Coolify managed DB kullaniyorsan paneldeki internal host'u yaz

# Ilk deploy: JSON -> MySQL migration (data/*.json varsa)
RUN_DB_MIGRATE=true

# WebSocket — Coolify'da bos birak (Traefik wss://domain/ws otomatik)
# NEXT_PUBLIC_WS_URL=wss://aldinaldinfirsatlari.com/ws

# SSL — Coolify Traefik kullanir, asagidakileri TANIMLAMA
# WS_SSL_KEY=
# WS_SSL_CERT=

# Site URL (build + runtime — domain ile eslestir)
NEXT_PUBLIC_APP_URL=https://aldinaldinfirsatlari.com
NEXT_PUBLIC_BASE_URL=https://aldinaldinfirsatlari.com
SITE_URL=https://aldinaldinfirsatlari.com

# Guvenlik
JWT_SECRET=degistir-uzun-rastgele-deger

# SMS (Ileti Merkezi)
# ILETI_MERKEZI_API_URL=
# ILETI_MERKEZI_KEY=
# ILETI_MERKEZI_HASH=
# ILETI_MERKEZI_SENDER=
# SMS_BYPASS=true
